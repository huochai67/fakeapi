# Gateway Configuration
PORT=3000

# Supported Models (comma-separated list for /v1/models and discovery)
MODELS=gpt5.5,gpt5.6,gpt5.6-sol,gpt6.1-sol,gpt6-astra

# Upstream LLM Configuration
MODEL=inclusionai/ling-3.1-flash
OPENAI_BASEURL=https://openrouter.ai/api/v1
OPENAI_APIKEY=your_openai_or_openrouter_api_key_here
ANTHROPIC_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_APIKEY=your_anthropic_or_openrouter_api_key_here

# Anti-Anti-Probing Strategy
MAX_FORWARD_COUNT=3

# TypeSafe Jev Decision Router (Optional System One Classifier)
ENABLE_JEV=true
JEV_TIMEOUT_MS=2500
JEV_MODEL=typesafe/jev-1.13

# Realistic TPS Pacing
TARGET_TPS=45
TPS_JITTER=0.08
MAX_STREAM_DURATION_SEC=25

# Logging and Presets
LOG_FILE=logs/gateway.log
PRESETS_FILE=presets.json
